# Modelo de configuração do JavaLog Agent.
# Copie para `.env` e preencha localmente. O arquivo `.env` NUNCA é versionado.
# Valores reais devem permanecer fora do repositório e ser fornecidos pelo ambiente.

# Chave da OpenAI. Opcional: sem ela o agente opera em fallback determinístico.
OPENAI_API_KEY=

# Modelo utilizado no nó de diagnóstico.
OPENAI_MODEL=

# Tempo máximo, em segundos, de espera pelo modelo.
LLM_TIMEOUT_SECONDS=

# Limite de passos do grafo, para impedir execução indefinida.
MAX_STEPS=

# Tamanho máximo, em bytes, do arquivo de log aceito.
MAX_LOG_SIZE_BYTES=

# Diretório único a partir do qual a leitura de logs é permitida.
ALLOWED_LOG_ROOT=

# Diretório único no qual a escrita de relatórios é permitida.
OUTPUT_ROOT=

# Caminho do log estruturado da aplicação (primeiro sinal de observabilidade).
APP_LOG_PATH=

# Caminho do registro de auditoria (segundo sinal de observabilidade).
AUDIT_LOG_PATH=
