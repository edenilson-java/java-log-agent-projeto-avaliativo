+
+
+@pytest.mark.parametrize("faltando", sorted(BASE_VALIDA))
+def test_audit_event_exige_todos_os_campos(faltando):
+    incompleto = {k: v for k, v in BASE_VALIDA.items() if k != faltando}
+
+    with pytest.raises(ValidationError):
